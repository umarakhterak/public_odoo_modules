<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="email_template_product_expiry_alert" model="mail.template">
        <field name="name">Product Expiry Alert</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="subject">[Alert] Product Expiry Coming Soon</field>
        <field name="email_from">{{ object.company_id.email }}</field>
        <field name="email_to">inventory@example.com</field>
        <field name="body_html" type="html">
            <p>Dear Inventory Team,</p>
            <p>The following products are about to expire:</p>
            <table style="width:300pt; height:85pt;" class="table table-borderless">
                <thead>
                    <tr>
                        <th>Product Name</th>
                        <th>Expiry Date</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-foreach="ctx.get('expiring_products', [])" t-as="product">
                        <tr>
                            <td>
                                <span t-esc="product.name"/>
                            </td>
                            <td>
                                <span t-esc="product.expiry_date"/>
                            </td>
                        </tr>
                    </t>
                </tbody>
            </table>
            <p>Please take appropriate action.</p>
        </field>
    </record>
</odoo>