<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="res_config_settings_view_form_inherit_min_qty" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.min.qty</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='operations_setting_container']/div[@id='reception_report']" position="after">
                <div class="col-12 col-lg-6 o_setting_box" id="warning_info">
                    <div class="o_setting_left_pane">
                        <field name="show_min_qty_field"/>
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="group_warning_stock" string="Minimum Quantity"/>
                        <div class="text-muted">
                            When this button is activated, the 'Minimum Stock Qty' field becomes visible in the product form view
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>